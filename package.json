{
  "name": "harbor-ui",
  "version": "0.1.0",
  "description": "A small, framework-agnostic design system: design tokens, accessible Web Components built with Lit, and Storybook docs.",
  "type": "module",
  "license": "MIT",
  "author": "Christopher Watson",
  "main": "./dist/harbor-ui.js",
  "module": "./dist/harbor-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/harbor-ui.js",
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/harbor-ui.js",
    "./src/index.ts",
    "./src/components/**/*.ts"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && storybook dev -p 6006",
    "build": "npm run tokens && rm -rf dist && tsc -p tsconfig.build.json && vite build",
    "build-storybook": "npm run tokens && storybook build -o storybook-static",
    "test": "npm run tokens && vitest run",
    "test:browser": "node tests/a11y-and-behavior.mjs",
    "typecheck": "npm run tokens && tsc --noEmit"
  },
  "dependencies": {
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.19",
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/blocks": "^8.6.19",
    "@storybook/manager-api": "^8.6.19",
    "@storybook/test": "^8.6.19",
    "@storybook/theming": "^8.6.19",
    "@storybook/web-components": "^8.6.19",
    "@storybook/web-components-vite": "^8.6.19",
    "axe-core": "^4.10.2",
    "playwright": "^1.49.0",
    "storybook": "^8.6.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "keywords": [
    "design-system",
    "web-components",
    "lit",
    "design-tokens",
    "storybook",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wedwu/harbor-ui"
  }
}

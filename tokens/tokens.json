{
  "$description": "Harbor UI design tokens. Primitives hold raw values; semantic tokens point at primitives and are what components use. Themes only remap semantic tokens.",
  "primitive": {
    "color": {
      "navy":  { "50": "#eef3fb", "100": "#d6e2f5", "300": "#8eaee3", "500": "#2f63c7", "600": "#2552a8", "700": "#1d4185", "900": "#0f2147" },
      "slate": { "0": "#ffffff", "50": "#f6f8fa", "100": "#eaeef2", "200": "#d6dce3", "400": "#8b96a3", "600": "#57606a", "700": "#3b434c", "800": "#22282f", "900": "#161b21", "950": "#0d1117" },
      "green": { "100": "#dcf5e6", "600": "#1a7f45", "300": "#6fd39a", "900": "#0f3a22" },
      "amber": { "100": "#fdf0d2", "700": "#8a5a00", "300": "#f2c35b", "900": "#3d2a05" },
      "red":   { "100": "#fde2e1", "600": "#c62828", "300": "#f28b85", "900": "#4a1210" }
    },
    "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px" },
    "radius": { "sm": "4px", "md": "8px", "lg": "12px", "pill": "999px" },
    "font": {
      "family": { "sans": "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif", "mono": "'JetBrains Mono', ui-monospace, monospace" },
      "size": { "sm": "0.8125rem", "md": "0.9375rem", "lg": "1.125rem", "xl": "1.375rem" },
      "weight": { "regular": "400", "medium": "500", "bold": "650" }
    },
    "shadow": { "sm": "0 1px 2px rgb(13 17 23 / 0.08)", "lg": "0 12px 32px rgb(13 17 23 / 0.18)" },
    "motion": { "fast": "120ms", "base": "200ms" }
  },
  "semantic": {
    "light": {
      "color-bg": "{color.slate.0}",
      "color-bg-subtle": "{color.slate.50}",
      "color-surface": "{color.slate.0}",
      "color-border": "{color.slate.200}",
      "color-border-strong": "{color.slate.400}",
      "color-text": "{color.slate.900}",
      "color-text-muted": "{color.slate.600}",
      "color-text-on-action": "{color.slate.0}",
      "color-action": "{color.navy.600}",
      "color-action-hover": "{color.navy.700}",
      "color-action-subtle": "{color.navy.50}",
      "color-focus": "{color.navy.500}",
      "color-info-bg": "{color.navy.50}",
      "color-info-fg": "{color.navy.700}",
      "color-success-bg": "{color.green.100}",
      "color-success-fg": "{color.green.600}",
      "color-warning-bg": "{color.amber.100}",
      "color-warning-fg": "{color.amber.700}",
      "color-danger-bg": "{color.red.100}",
      "color-danger-fg": "{color.red.600}",
      "color-backdrop": "rgb(13 17 23 / 0.5)"
    },
    "dark": {
      "color-bg": "{color.slate.950}",
      "color-bg-subtle": "{color.slate.900}",
      "color-surface": "{color.slate.800}",
      "color-border": "{color.slate.700}",
      "color-border-strong": "{color.slate.400}",
      "color-text": "{color.slate.50}",
      "color-text-muted": "{color.slate.400}",
      "color-text-on-action": "{color.navy.900}",
      "color-action": "{color.navy.300}",
      "color-action-hover": "{color.navy.100}",
      "color-action-subtle": "{color.navy.900}",
      "color-focus": "{color.navy.300}",
      "color-info-bg": "{color.navy.900}",
      "color-info-fg": "{color.navy.100}",
      "color-success-bg": "{color.green.900}",
      "color-success-fg": "{color.green.300}",
      "color-warning-bg": "{color.amber.900}",
      "color-warning-fg": "{color.amber.300}",
      "color-danger-bg": "{color.red.900}",
      "color-danger-fg": "{color.red.300}",
      "color-backdrop": "rgb(0 0 0 / 0.65)"
    }
  }
}
